# Copy into Vercel → Project → Settings → Environment Variables.
# Do not commit real values.

# Postgres connection string (Neon or any Postgres). Required for saved schemes.
DATABASE_URL=

# Auth secret, at least 32 characters. Required in production.
BETTER_AUTH_SECRET=

# Public site URL, for example https://your-app.vercel.app
BETTER_AUTH_URL=

# Optional. Teachers can also save keys inside the app admin page.
XAI_API_KEY=

# Optional dedicated key for encrypting saved AI keys. Falls back to BETTER_AUTH_SECRET.
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional. Protects the generation worker route.
CRON_SECRET=
